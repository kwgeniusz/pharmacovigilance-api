{
  "info": {
    "_postman_id": "92b68b96-e9ba-4ea7-b778-a57d44dc1c97",
    "name": "Pharmacovigilance API",
    "description": "Run in order: initialize CSRF, log in, test protected endpoints, send an alert, and log out.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{
    "listen": "prerequest",
    "script": {"type": "text/javascript", "exec": [
      "const frontendUrl = pm.collectionVariables.get('frontendUrl');",
      "pm.request.headers.upsert({key: 'Accept', value: 'application/json'});",
      "pm.request.headers.upsert({key: 'Origin', value: frontendUrl});",
      "pm.request.headers.upsert({key: 'Referer', value: `${frontendUrl}/`});",
      "const formatDate = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;",
      "const end = new Date(); const start = new Date(); start.setDate(start.getDate() - 30);",
      "pm.collectionVariables.set('startDate', formatDate(start)); pm.collectionVariables.set('endDate', formatDate(end));",
      "if (!['GET','HEAD','OPTIONS'].includes(pm.request.method)) { const token = pm.collectionVariables.get('csrfToken'); if (token) pm.request.headers.upsert({key: 'X-XSRF-TOKEN', value: token}); }"
    ]}
  }],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8000"},
    {"key": "frontendUrl", "value": "http://localhost:5173"},
    {"key": "username", "value": "admin"},
    {"key": "password", "value": "password"},
    {"key": "lotNumber", "value": "951357"},
    {"key": "csrfToken", "value": ""},
    {"key": "orderId", "value": ""},
    {"key": "customerId", "value": ""},
    {"key": "startDate", "value": ""},
    {"key": "endDate", "value": ""}
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Initialize CSRF Cookie",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('CSRF cookie initialized', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));",
            "const cookie = pm.response.headers.all().find(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('XSRF-TOKEN='));",
            "pm.test('XSRF-TOKEN returned', () => pm.expect(cookie).to.exist);",
            "const encoded = cookie?.value.match(/^XSRF-TOKEN=([^;]+)/)?.[1]; if (encoded) pm.collectionVariables.set('csrfToken', decodeURIComponent(encoded));"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/sanctum/csrf-cookie", "description": "Creates the Laravel session and XSRF cookies."}
        },
        {
          "name": "Login",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Login succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.username).to.eql(pm.collectionVariables.get('username')); });"
          ]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{baseUrl}}/api/login"}
        },
        {
          "name": "Refresh CSRF Cookie After Login",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Authenticated CSRF cookie refreshed', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));",
            "const cookie = pm.response.headers.all().find(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('XSRF-TOKEN='));",
            "pm.test('Fresh XSRF-TOKEN returned', () => pm.expect(cookie).to.exist);",
            "const encoded = cookie?.value.match(/^XSRF-TOKEN=([^;]+)/)?.[1]; if (encoded) pm.collectionVariables.set('csrfToken', decodeURIComponent(encoded));"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/sanctum/csrf-cookie", "description": "Refreshes the XSRF token after Laravel regenerates the session during login."}
        },
        {
          "name": "Current User",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Authenticated user returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.username).to.eql(pm.collectionVariables.get('username')); });"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/user"}
        }
      ]
    },
    {
      "name": "2. Pharmacovigilance",
      "item": [
        {
          "name": "Search Medication by Lot",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Medication is found', () => { pm.response.to.have.status(200); const data=pm.response.json().data; pm.expect(data).to.be.an('array').that.is.not.empty; pm.expect(data[0].lot_number).to.eql(pm.collectionVariables.get('lotNumber')); });"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/medications/search?lot_number={{lotNumber}}"}
        },
        {
          "name": "Search Orders - Default Rolling Window",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const response=pm.response.json(); pm.test('Affected orders are paginated', () => { pm.response.to.have.status(200); pm.expect(response.data).to.be.an('array').that.is.not.empty; pm.expect(response).to.have.all.keys('data','links','meta'); });",
            "const order=response.data?.[0]; if (order) { pm.collectionVariables.set('orderId', String(order.id)); pm.collectionVariables.set('customerId', String(order.customer.id)); }"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/orders?lot_number={{lotNumber}}&page=1", "description": "Uses the default rolling 30 days and captures IDs for the next requests."}
        },
        {
          "name": "Search Orders - Explicit Date Range",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Inclusive range succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty; });"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/orders?lot_number={{lotNumber}}&start_date={{startDate}}&end_date={{endDate}}&page=1"}
        },
    {
      "name": "Export Orders CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CSV export succeeds for administrator', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'); pm.expect(pm.response.text()).to.include('Order ID,Customer,Email,Phone,Purchase Date,Medication,Lot Number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/csv"
          }
        ],
        "url": "{{baseUrl}}/api/orders/export?lot_number={{lotNumber}}&start_date={{startDate}}&end_date={{endDate}}",
        "description": "Administrator-only export containing all orders matching the active filters."
      }
    },
    {
      "name": "Order Details",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Order includes customer and items', () => { pm.response.to.have.status(200); const data=pm.response.json().data; pm.expect(data.customer).to.be.an('object'); pm.expect(data.items).to.be.an('array').that.is.not.empty; });"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}"}
        },
        {
          "name": "Customer Details",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Customer includes order history', () => { pm.response.to.have.status(200); const data=pm.response.json().data; pm.expect(data.email).to.be.a('string'); pm.expect(data.orders).to.be.an('array').that.is.not.empty; });"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/customers/{{customerId}}"}
        },
        {
          "name": "Send Buyer Alert",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Alert is accepted', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().message).to.eql('Alert sent successfully.'); });"
          ]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"order_id\": {{orderId}},\n  \"lot_number\": \"{{lotNumber}}\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{baseUrl}}/api/alerts/send", "description": "Inspect the delivered message at http://localhost:8025."}
        }
      ]
    },
    {
      "name": "3. Expected Validation Errors",
      "item": [
        {
          "name": "Medication Search Without Lot",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Missing lot is rejected', () => { pm.response.to.have.status(422); pm.expect(pm.response.json().errors).to.have.property('lot_number'); });"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/medications/search"}
        },
        {
          "name": "Orders With Reversed Date Range",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Reversed range is rejected', () => { pm.response.to.have.status(422); pm.expect(pm.response.json().errors).to.have.property('end_date'); });"
          ]}}],
          "request": {"method": "GET", "url": "{{baseUrl}}/api/orders?lot_number={{lotNumber}}&start_date={{endDate}}&end_date={{startDate}}"}
        },
        {
          "name": "Alert for Lot Not Present in Order",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Unrelated lot is rejected', () => { pm.response.to.have.status(422); pm.expect(pm.response.json().errors).to.have.property('lot_number'); });"
          ]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"order_id\": {{orderId}},\n  \"lot_number\": \"000000\"\n}", "options": {"raw": {"language": "json"}}}, "url": "{{baseUrl}}/api/alerts/send"}
        }
      ]
    },
    {
      "name": "4. Logout",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Session is closed', () => pm.response.to.have.status(204));"]}}],
      "request": {"method": "POST", "url": "{{baseUrl}}/api/logout"}
    }
  ]
}
